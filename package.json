{
  "name": "git-drift",
  "version": "0.2.1",
  "description": "Find code that never made it to GitHub: on your servers and your laptop. Uncommitted edits, unpushed branches, stale or hand-edited deploys, checked file by file over plain SSH.",
  "author": "John Murphy (https://github.com/chiefsmurph)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiefsmurph/git-drift.git"
  },
  "homepage": "https://github.com/chiefsmurph/git-drift#readme",
  "bugs": {
    "url": "https://github.com/chiefsmurph/git-drift/issues"
  },
  "type": "module",
  "bin": {
    "git-drift": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "build": "npm run gen && rm -rf dist && tsc -p . && chmod +x dist/src/cli.js",
    "typecheck": "npm run gen && tsc -p . --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "compile": "npm run gen && node scripts/compile.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "audit",
    "deploy",
    "devops",
    "drift",
    "file-integrity",
    "git",
    "git-status",
    "github",
    "rsync",
    "server",
    "ssh",
    "uncommitted",
    "unpushed",
    "vps"
  ],
  "license": "MIT",
  "dependencies": {
    "ignore": "^7.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
